{
  "name": "khmer-name-romanizer",
  "version": "0.2.0",
  "description": "Khmer script to Latin transliteration for Cambodian personal names - token dictionary + rule engine, zero dependencies",
  "license": "MIT",
  "author": "hangsopheak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hangsopheak/khmer-name-romanizer.git"
  },
  "bugs": {
    "url": "https://github.com/hangsopheak/khmer-name-romanizer/issues"
  },
  "homepage": "https://github.com/hangsopheak/khmer-name-romanizer#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "khmer-name-romanizer": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval:famous": "node scripts/eval-famous.mjs",
    "scrape:names": "python3 scripts/scrape_names.py",
    "eval:scraped": "node scripts/eval-scraped.mjs",
    "mine:tokens": "node scripts/mine-tokens.mjs",
    "merge:tokens": "node scripts/merge-tokens.mjs && npm run build",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "khmer",
    "cambodian",
    "transliteration",
    "romanization",
    "names",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}

+
+/* EXPERIMENT (round 2, workstream B): rewrites between official spellings.
+ * For every Khmer word with two or more distinct official spellings in
+ * the given rows, each ordered pair (a -> b) yields edits like
+ * learnRules does; opportunities are pattern occurrences over every
+ * distinct official spelling in the rows. */
+export const learnVariantRules = (rows, opts = {}) => {
+    const { alpha, minSuccess, minP } = { ...DEFAULTS, ...opts }
+    const byKhmer = new Map()
+    for (const { khmer, latin } of trainingPairs(rows)) {
+        if (!byKhmer.has(khmer)) byKhmer.set(khmer, new Set())
+        byKhmer.get(khmer).add(latin)
+    }
+    const spellings = new Set()
+    const success = new Map()
+    for (const set of byKhmer.values()) {
+        for (const w of set) spellings.add(`^${w}$`)
+        if (set.size < 2) continue
+        for (const a of set) {
+            // one success per (spelling, rewrite), however many partners
+            const seen = new Set()
+            for (const b of set) {
+                if (a === b) continue
+                const edits = alignEdits(a, b)
+                const size = edits.reduce((n, e) => n + Math.max(e.end - e.start, e.to.length), 0)
+                if (size > (opts.maxEdit ?? 2)) continue
+                const padded = `^${a}$`
+                for (const ed of edits) {
+                    for (const [l, from, r] of contexts(padded, ed.start + 1, ed.end + 1)) {
+                        const key = `${l}|${from}|${ed.to}|${r}`
+                        if (seen.has(key)) continue
+                        seen.add(key)
+                        success.set(key, (success.get(key) ?? 0) + 1)
+                    }
+                }
+            }
+        }
+    }
+    const patterns = new Map()
+    for (const key of success.keys()) {
+        const [l, from, , r] = key.split('|')
+        patterns.set(l + from + r, 0)
+    }
+    for (const padded of spellings)
+        for (const pattern of patterns.keys()) {
+            let at = padded.indexOf(pattern)
+            while (at !== -1) {
+                patterns.set(pattern, patterns.get(pattern) + 1)
+                at = padded.indexOf(pattern, at + 1)
+            }
+        }
+    const rules = []
+    for (const [key, s] of success) {
+        if (s < minSuccess) continue
+        const [l, from, to, r] = key.split('|')
+        const p = s / (patterns.get(l + from + r) + alpha)
+        if (p < minP) continue
+        rules.push([l, from, to, r, +p.toFixed(3)])
+    }
+    return rules.sort((a, b) => a.slice(0, 4).join('|').localeCompare(b.slice(0, 4).join('|')))
+}

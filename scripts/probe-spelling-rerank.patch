+/**
+ * A letter model of official name spellings, used to rerank the extra
+ * spellings offered for words the dictionary does not know.
+ *
+ * The rules and the learned rewrites often produce several readings of an
+ * unknown word (Sihno / Sihnou / Seyhno). Official spellings follow
+ * strong letter habits (-ouk, -eath, -oeun), so a character n-gram model
+ * trained on the dictionary's own Latin spellings tells a plausible name
+ * spelling from an unlikely one.
+ *
+ * The model is built from the dictionary the transliterator is given, so
+ * it ships no data of its own, and in cross-validation it only ever sees
+ * the fold's training dictionary. Interpolated Witten-Bell smoothing,
+ * `^` / `$` mark the word boundaries; every distinct spelling counts once
+ * (a frequent name cannot dominate).
+ */
+
+export interface SpellingModel {
+    /** Natural-log probability of a lower-case word, end marker included. */
+    logProb: (word: string) => number
+}
+
+const ORDER = 4
+/** Letters a name spelling can use, plus the end marker. */
+const ALPHABET_SIZE = 27
+
+export function createSpellingModel(spellings: Iterable<string>): SpellingModel {
+    // counts.get(history).get(next) for every history length 0..ORDER-1
+    const counts = new Map<string, Map<string, number>>()
+    const totals = new Map<string, number>()
+    const seen = new Set<string>()
+    for (const raw of spellings) {
+        for (const word of raw.toLowerCase().split(/[^a-z]+/)) {
+            if (!word || seen.has(word)) continue
+            seen.add(word)
+            const padded = '^'.repeat(ORDER - 1) + word + '$'
+            for (let i = ORDER - 1; i < padded.length; i++) {
+                const next = padded[i]
+                for (let n = 0; n < ORDER; n++) {
+                    const history = padded.slice(i - n, i)
+                    let row = counts.get(history)
+                    if (!row) counts.set(history, (row = new Map()))
+                    row.set(next, (row.get(next) ?? 0) + 1)
+                    totals.set(history, (totals.get(history) ?? 0) + 1)
+                }
+            }
+        }
+    }
+
+    const prob = (history: string, next: string): number => {
+        const lower = history.length ? prob(history.slice(1), next) : 1 / ALPHABET_SIZE
+        const row = counts.get(history)
+        if (!row) return lower
+        const total = totals.get(history)!
+        const types = row.size
+        return ((row.get(next) ?? 0) + types * lower) / (total + types)
+    }
+
+    const cache = new Map<string, number>()
+    return {
+        logProb: (word) => {
+            const hit = cache.get(word)
+            if (hit !== undefined) return hit
+            const padded = '^'.repeat(ORDER - 1) + word + '$'
+            let lp = 0
+            for (let i = ORDER - 1; i < padded.length; i++) lp += Math.log(prob(padded.slice(i - ORDER + 1, i), padded[i]))
+            if (cache.size >= 5000) cache.clear()
+            cache.set(word, lp)
+            return lp
+        },
+    }
+}
